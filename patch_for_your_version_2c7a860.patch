diff --git a/workspace/all/common/i18n.h b/workspace/all/common/i18n.h
new file mode 100644
index 0000000..a22ad38
--- /dev/null
+++ b/workspace/all/common/i18n.h
@@ -0,0 +1,24 @@
+#ifndef I18N_H
+#define I18N_H
+
+// Runtime translation. Dictionary file: <sdcard>/.system/res/lang.txt
+// Format, one entry per line:   English text => Русский текст
+// Lines starting with # are comments. Missing file or missing entry = original text.
+// If the dictionary contains the line   #log   every text that has no translation is
+// appended to <sdcard>/.userdata/shared/untranslated.txt (one per line, no duplicates).
+
+const char* I18N_T(const char* text);
+
+// Every text measured or drawn through SDL_ttf passes through the dictionary.
+// A function-like macro is not re-expanded inside its own expansion, so the
+// inner name below is the real SDL_ttf function.
+#ifdef TTF_RenderUTF8_Blended
+#undef TTF_RenderUTF8_Blended
+#endif
+#ifdef TTF_SizeUTF8
+#undef TTF_SizeUTF8
+#endif
+#define TTF_RenderUTF8_Blended(font, text, color) TTF_RenderUTF8_Blended((font), I18N_T(text), (color))
+#define TTF_SizeUTF8(font, text, w, h) TTF_SizeUTF8((font), I18N_T(text), (w), (h))
+
+#endif
diff --git a/workspace/all/common/i18n_impl.h b/workspace/all/common/i18n_impl.h
new file mode 100644
index 0000000..04b23d3
--- /dev/null
+++ b/workspace/all/common/i18n_impl.h
@@ -0,0 +1,154 @@
+// Implementation of the runtime dictionary (included once, from api.c).
+// Kept separate from api.c so it can be unit-tested on a PC.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef I18N_DICT_PATH
+#define I18N_DICT_PATH RES_PATH "/lang.txt"
+#endif
+#ifndef I18N_LOG_PATH
+#define I18N_LOG_PATH SHARED_USERDATA_PATH "/untranslated.txt"
+#endif
+
+typedef struct {
+	char* key;
+	char* val;
+} I18N_Entry;
+
+static struct {
+	int loaded;
+	int logging;
+	char* data;          // whole file, modified in place
+	I18N_Entry* table;   // open addressing, size is a power of two
+	unsigned size;
+	unsigned count;
+	// misses already logged this session (to avoid duplicates)
+	char** seen;
+	unsigned seen_count;
+	unsigned seen_cap;
+} i18n;
+
+static unsigned I18N_hash(const char* s) {
+	unsigned h = 2166136261u;
+	while (*s) {
+		h ^= (unsigned char)*s++;
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void I18N_insert(char* key, char* val) {
+	unsigned i = I18N_hash(key) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, key)) { // later entry wins
+			i18n.table[i].val = val;
+			return;
+		}
+		i = (i + 1) & (i18n.size - 1);
+	}
+	i18n.table[i].key = key;
+	i18n.table[i].val = val;
+	i18n.count++;
+}
+
+static char* I18N_trim(char* s) {
+	while (*s==' ' || *s=='\t') s++;
+	char* e = s + strlen(s);
+	while (e>s && (e[-1]==' ' || e[-1]=='\t')) *--e = '\0';
+	return s;
+}
+
+static void I18N_load(void) {
+	i18n.loaded = 1;
+	FILE* f = fopen(I18N_DICT_PATH, "rb");
+	if (!f) return;
+	fseek(f, 0, SEEK_END);
+	long len = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	if (len<=0 || len>(4L*1024*1024)) { fclose(f); return; }
+	i18n.data = malloc(len + 1);
+	if (!i18n.data) { fclose(f); return; }
+	size_t got = fread(i18n.data, 1, len, f);
+	fclose(f);
+	i18n.data[got] = '\0';
+
+	char* p = i18n.data;
+	if ((unsigned char)p[0]==0xEF && (unsigned char)p[1]==0xBB && (unsigned char)p[2]==0xBF) p += 3; // BOM
+
+	// count lines to size the table
+	unsigned lines = 1;
+	for (char* c = p; *c; c++) if (*c=='\n') lines++;
+	unsigned size = 64;
+	while (size < lines * 2) size <<= 1;
+	i18n.table = calloc(size, sizeof(I18N_Entry));
+	if (!i18n.table) { free(i18n.data); i18n.data = NULL; return; }
+	i18n.size = size;
+
+	while (*p) {
+		char* eol = strchr(p, '\n');
+		if (eol) *eol = '\0';
+		char* next = eol ? eol + 1 : p + strlen(p);
+
+		size_t l = strlen(p);
+		if (l && p[l-1]=='\r') p[l-1] = '\0';
+
+		if (p[0]=='#') {
+			if (!strcmp(I18N_trim(p), "#log")) i18n.logging = 1;
+		}
+		else if (p[0]) {
+			char* sep = strstr(p, " => ");
+			if (sep) {
+				*sep = '\0';
+				char* key = I18N_trim(p);
+				char* val = I18N_trim(sep + 4);
+				if (key[0] && val[0]) I18N_insert(key, val);
+			}
+		}
+		p = next;
+	}
+}
+
+static void I18N_logMiss(const char* text) {
+	for (unsigned i=0; i<i18n.seen_count; i++) {
+		if (!strcmp(i18n.seen[i], text)) return;
+	}
+	if (i18n.seen_count==i18n.seen_cap) {
+		unsigned cap = i18n.seen_cap ? i18n.seen_cap * 2 : 128;
+		char** grown = realloc(i18n.seen, cap * sizeof(char*));
+		if (!grown) return;
+		i18n.seen = grown;
+		i18n.seen_cap = cap;
+	}
+	char* copy = strdup(text);
+	if (!copy) return;
+	i18n.seen[i18n.seen_count++] = copy;
+
+	FILE* f = fopen(I18N_LOG_PATH, "ab");
+	if (!f) return;
+	fprintf(f, "%s\n", text);
+	fclose(f);
+}
+
+static int I18N_hasLetters(const char* s) {
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if ((c>='A' && c<='Z') || (c>='a' && c<='z')) return 1;
+	}
+	return 0;
+}
+
+const char* I18N_T(const char* text) {
+	if (!text || !text[0]) return text;
+	if (!i18n.loaded) I18N_load();
+	if (!i18n.table) return text;
+
+	unsigned i = I18N_hash(text) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, text)) return i18n.table[i].val;
+		i = (i + 1) & (i18n.size - 1);
+	}
+	if (i18n.logging && I18N_hasLetters(text)) I18N_logMiss(text);
+	return text;
+}
