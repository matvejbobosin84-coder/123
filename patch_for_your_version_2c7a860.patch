+// ---- "About the console" screen (opened with a tap on MENU) ----
+static void About_row(SDL_Surface* screen, int s, int x, int y, int w, int h, const char* label, const char* value, int mr, int mg, int mb) {
+	SDL_Surface* l = (TTF_RenderUTF8_Blended)(font.small, label, (SDL_Color){mr, mg, mb});
+	if (l) { SDL_BlitSurface(l, NULL, screen, &(SDL_Rect){x + 8*s, y + (h - l->h)/2}); SDL_FreeSurface(l); }
+	char shown[160];
+	GFX_truncateText(font.small, value, shown, w/2 + 24*s, 0);
+	SDL_Surface* v = (TTF_RenderUTF8_Blended)(font.small, shown, COLOR_WHITE);
+	if (v) { SDL_BlitSurface(v, NULL, screen, &(SDL_Rect){x + w - v->w - 8*s, y + (h - v->h)/2}); SDL_FreeSurface(v); }
+}
+
+static void About_draw(SDL_Surface* screen, const char* modeStr) {
+	int W = screen->w;
+	int s = W/320; if (s<1) s = 1;
+	int M = 12*s;
+	int mr, mg, mb, pr, pg, pb;
+	GFX_themeColor(1, &mr, &mg, &mb);
+	GFX_themeColor(3, &pr, &pg, &pb);
+
+	SDL_Surface* t = (TTF_RenderUTF8_Blended)(font.large, "О приставке", COLOR_WHITE);
+	if (t) { SDL_BlitSurface(t, NULL, screen, &(SDL_Rect){M, 10*s}); SDL_FreeSurface(t); }
+
+	char vals[10][160];
+	const char* labels[10];
+	int n = 0;
+
+	char* model = PLAT_getModel();
+	labels[n] = "Модель"; snprintf(vals[n], 160, "%s", model ? model : "?"); n++;
+
+	char rel[256]; rel[0] = '\0';
+	getFile(ROOT_SYSTEM_PATH "/version.txt", rel, 256);
+	{
+		char* nl = strchr(rel, '\n');
+		if (nl) *nl = '\0';
+		labels[n] = "Сборка"; snprintf(vals[n], 160, "%s", rel[0] ? rel : "?"); n++;
+	}
+
+	labels[n] = "Батарея";
+	snprintf(vals[n], 160, "%d%%%s", PWR_getBattery(), PWR_isCharging() ? " (заряжается)" : ""); n++;
+
+	{
+		struct statvfs sv;
+		if (statvfs(SDCARD_PATH, &sv)==0) {
+			double fr = (double)sv.f_bavail * sv.f_frsize / 1073741824.0;
+			double to = (double)sv.f_blocks * sv.f_frsize / 1073741824.0;
+			labels[n] = "Карта памяти";
+			snprintf(vals[n], 160, "свободно %.1f из %.1f ГБ", fr, to); n++;
+		}
+	}
+	{
+		FILE* f = fopen("/proc/meminfo", "r");
+		if (f) {
+			char line[128];
+			long total = 0, avail = 0;
+			while (fgets(line, sizeof(line), f)) {
+				if (sscanf(line, "MemTotal: %ld", &total)==1) continue;
+				if (sscanf(line, "MemAvailable: %ld", &avail)==1) continue;
+			}
+			fclose(f);
+			if (total>0) { labels[n] = "Память (RAM)"; snprintf(vals[n], 160, "свободно %ld из %ld МБ", avail/1024, total/1024); n++; }
+		}
+	}
+	{
+		FILE* f = fopen("/sys/class/thermal/thermal_zone0/temp", "r");
+		if (f) {
+			long v = 0;
+			if (fscanf(f, "%ld", &v)==1) {
+				if (v>1000) v /= 1000;
+				labels[n] = "Температура"; snprintf(vals[n], 160, "%ld °C", v); n++;
+			}
+			fclose(f);
+		}
+	}
+	{
+		FILE* f = fopen("/proc/uptime", "r");
+		if (f) {
+			double up = 0;
+			if (fscanf(f, "%lf", &up)==1) {
+				int m = (int)(up/60);
+				labels[n] = "Включена";
+				if (m<60) snprintf(vals[n], 160, "%d мин", m);
+				else snprintf(vals[n], 160, "%d ч %d мин", m/60, m%60);
+				n++;
+			}
+			fclose(f);
+		}
+	}
+	{
+		char pf[48];
+		PT_format(PT_total(), pf, sizeof(pf));
+		labels[n] = "Всего сыграно"; snprintf(vals[n], 160, "%s", pf); n++;
+	}
+	labels[n] = "Режим (вверх/вниз)"; snprintf(vals[n], 160, "%s", modeStr); n++;
+
+	int top_y = 36*s;
+	int row_h = 17*s;
+	int pw = W - M*2;
+	GFX_fillRound(screen, M, top_y - 3*s, pw, row_h*n + 6*s, 8*s, SDL_MapRGB(screen->format, pr, pg, pb));
+	for (int i=0; i<n; i++) About_row(screen, s, M, top_y + i*row_h, pw, row_h, labels[i], vals[i], mr, mg, mb);
+}
