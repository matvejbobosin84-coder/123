+// ---------------------------------------------------------------
+// Pause menu, tile style (dark blue background, bright rows)
+// ---------------------------------------------------------------
+static void Menu_consoleName(char* out, int size) {
+	// folder name of the rom without "(TAG)" and sorting prefix, same name as the tile in the main menu
+	out[0] = '\0';
+	char dir[256];
+	strncpy(dir, game.path, sizeof(dir)-1);
+	dir[sizeof(dir)-1] = '\0';
+	char* slash = strrchr(dir, '/');
+	if (!slash) return;
+	*slash = '\0';
+	char* name = strrchr(dir, '/');
+	name = name ? name+1 : dir;
+	// sorting prefix like "01) "
+	char* p = name;
+	while (*p>='0' && *p<='9') p++;
+	if (p!=name && p[0]==')' ) { p++; while (*p==' ') p++; name = p; }
+	strncpy(out, name, size-1);
+	out[size-1] = '\0';
+	char* par = strrchr(out, '(');
+	if (par && par!=out) { *par = '\0'; }
+	int n = (int)strlen(out);
+	while (n>0 && out[n-1]==' ') out[--n] = '\0';
+}
