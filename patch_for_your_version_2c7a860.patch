+static TTF_Font* tile_big_font = NULL;
+
+static void Tile_draw(SDL_Surface* screen, Directory* dir, int total) {
+	if (!tile_big_font) {
+		tile_big_font = TTF_OpenFont(FONT_PATH, SCALE1(24));
+		if (!tile_big_font) tile_big_font = font.large;
+	}
+	int W = screen->w, H = screen->h;
+	int s = W/320; if (s<1) s = 1; // pixel unit (same as SCALE1 on 640 wide)
+	int margin = 12*s;
+	int gap = 7*s;
+	int top_y = 40*s;
+	int bottom_reserved = 42*s; // hint row + dots
+	int cell_w = (W - margin*2 - gap*(TILE_COLS-1)) / TILE_COLS;
+	int cell_h = (H - top_y - bottom_reserved - 6*s - gap*(TILE_ROWS-1)) / TILE_ROWS;
+	int radius = 10*s;
+
+	int selected = dir->selected;
+	int page = selected / TILE_PER_PAGE;
+	int pages = (total + TILE_PER_PAGE - 1) / TILE_PER_PAGE;
+	int first = page * TILE_PER_PAGE;
+
+	// title + page counter
+	char title[64];
+	SDL_Surface* t = TTF_RenderUTF8_Blended(font.large, "Main Menu", COLOR_WHITE);
+	if (t) { SDL_BlitSurface(t, NULL, screen, &(SDL_Rect){margin, 10*s}); SDL_FreeSurface(t); }
+	if (pages>0) {
+		snprintf(title, sizeof(title), "%d / %d", selected+1, total);
+		SDL_Color cnt_color = {0xB8,0xBC,0xE0};
+		SDL_Surface* c = TTF_RenderUTF8_Blended(font.small, title, cnt_color);
+		if (c) { SDL_BlitSurface(c, NULL, screen, &(SDL_Rect){W/2 - c->w/2 + 30*s, 14*s}); SDL_FreeSurface(c); }
+	}
+
+	for (int k=0; k<TILE_PER_PAGE; k++) {
+		int i = first + k;
+		if (i>=total) break;
+		Entry* e = dir->entries->items[i];
+		int col = k % TILE_COLS, row = k / TILE_COLS;
+		int x = margin + col*(cell_w+gap);
+		int y = top_y + row*(cell_h+gap);
+		int w = cell_w, h = cell_h;
+		int sel = (i==selected);
+		int cr, cg, cb, dark;
+		Tile_color(e, &cr, &cg, &cb, &dark);
+		if (sel) {
+			// white outline, tile slightly larger
+			int o = 3*s;
+			Tile_fillRound(screen, x-o-s, y-o-s, w+(o+s)*2, h+(o+s)*2, radius+o, Tile_pack(screen, 255,255,255));
+			Tile_fillRound(screen, x-s, y-s, w+s*2, h+s*2, radius+s, Tile_pack(screen, cr,cg,cb));
+		} else {
+			// dim non-selected tiles a little so the selected one pops
+			Tile_fillRound(screen, x, y, w, h, radius, Tile_pack(screen, cr*85/100, cg*85/100, cb*85/100));
+		}
+		int tr = sel ? cr : cr*85/100, tg = sel ? cg : cg*85/100, tb = sel ? cb : cb*85/100;
+		SDL_Color tc = dark ? (SDL_Color){0x0B,0x10,0x20} : (SDL_Color){0xFF,0xFF,0xFF};
+
+		char* name = e->name;
+		trimSortingMeta(&name);
+		{
+			int isz = h*40/100;
+			Tile_icon(screen, x+w-isz-9*s, y+8*s, isz, Tile_iconKind(e, name), Tile_pack(screen, tr, tg, tb));
+		}
+		char abbr[16];
+		Tile_abbrev(name, abbr, sizeof(abbr));
+		SDL_Surface* big = TTF_RenderUTF8_Blended(tile_big_font, abbr, tc);
+		if (big) { SDL_BlitSurface(big, NULL, screen, &(SDL_Rect){x+9*s, y+8*s}); SDL_FreeSurface(big); }
+
+		char shown[256];
+		GFX_truncateText(font.medium, name, shown, w-14*s, 0);
+		SDL_Surface* nm = TTF_RenderUTF8_Blended(font.medium, shown, tc);
+		if (nm) { SDL_BlitSurface(nm, NULL, screen, &(SDL_Rect){x+9*s, y+h-nm->h-8*s}); SDL_FreeSurface(nm); }
+	}
+
+	// page dots
+	if (pages>1) {
+		int dw = 8*s, dh = 4*s, dg = 5*s;
+		int active_w = 14*s;
+		int total_w = (pages-1)*(dw+dg) + active_w;
+		int dx = W/2 - total_w/2;
+		int dy = top_y + cell_h*TILE_ROWS + gap*(TILE_ROWS-1) + 10*s;
+		for (int p=0; p<pages; p++) {
+			int ww = (p==page) ? active_w : dw;
+			Tile_fillRound(screen, dx, dy, ww, dh, dh/2, (p==page) ? Tile_pack(screen,255,255,255) : Tile_pack(screen,0x5B,0x60,0x94));
+			dx += ww + dg;
+		}
+	}
+}
