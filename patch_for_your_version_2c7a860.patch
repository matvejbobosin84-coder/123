+
+// Logo screen shown while a game / program is starting:
+// dark blue background + .system/res/loading.png (any PNG; replace it with your own logo)
+static void Logo_show(int hold) { // hold: -1 = default / file setting, 0 = no pause
+	SDL_Surface* screen = gfx.screen;
+	if (!screen) return;
+
+	SB_gradient(screen);
+	SDL_Surface* logo = IMG_Load(RES_PATH "/loading.png");
+	if (logo) {
+		SDL_Rect dst = {(screen->w-logo->w)/2, (screen->h-logo->h)/2, logo->w, logo->h};
+		SDL_BlitSurface(logo, NULL, screen, &dst);
+		SDL_FreeSurface(logo);
+	}
+	GFX_flip(screen);
+	GFX_pan();
+
+	// keep the logo visible for a moment (files .userdata/shared/loading-ms when launching a game and startup-ms at power on: milliseconds, 0 = no pause)
+	int ms = hold<0 ? 1200 : hold;
+	FILE* f = fopen(hold<0 ? SHARED_USERDATA_PATH "/loading-ms" : SHARED_USERDATA_PATH "/startup-ms", "r");
+	if (!f) f = fopen(hold<0 ? SHARED_USERDATA_PATH "/loading-ms.txt" : SHARED_USERDATA_PATH "/startup-ms.txt", "r");
+	if (f) {
+		char buf[32] = {0};
+		size_t n = fread(buf, 1, sizeof(buf)-1, f);
+		fclose(f);
+		buf[n] = '\0';
+		char* p = buf;
+		while (*p && (*p<'0' || *p>'9')) p++;
+		if (*p) { int v = atoi(p); if (v>=0 && v<=10000) ms = v; }
+	}
+	if (ms>0) SDL_Delay(ms);
+}
+
+void GFX_showLoading(void) { Logo_show(-1); } // when launching a game
+void GFX_showStartup(void) { Logo_show(2000); }  // right after the menu program starts
+
+// clock + low battery warning, right-aligned at x_right, top y, height h (h = pill height). Returns used width (0 if nothing drawn).
+int GFX_drawStatusExtras(SDL_Surface* dst, int x_right, int y, int h, int with_clock) {
+	if (!dst) return 0;
+	int u = FIXED_SCALE;
+	int used = 0;
+	if (with_clock) {
+		time_t t = time(NULL);
+		struct tm* lt = localtime(&t);
+		char buf[16];
+		snprintf(buf, sizeof(buf), "%02d:%02d", lt ? lt->tm_hour : 0, lt ? lt->tm_min : 0);
+		SDL_Surface* ts = SB_text(font.medium, buf, (SDL_Color){255,255,255});
+		if (ts) {
+			int pw = ts->w + 14*u, x = x_right - pw;
+			UI_fillRound(dst, x, y, pw, h, h/2, SDL_MapRGB(dst->format, 0, 0, 0));
+			SDL_BlitSurface(ts, NULL, dst, &(SDL_Rect){x + 7*u, y + (h - ts->h)/2});
+			SDL_FreeSurface(ts);
+			used = pw + 6*u;
+		}
+	}
+	if (!PWR_isCharging() && PWR_getBattery()<=20) {
+		SDL_Surface* ws = SB_text(font.small, "Низкий заряд", (SDL_Color){255,255,255});
+		if (ws) {
+			int pw = ws->w + 14*u, x = x_right - used - pw;
+			UI_fillRound(dst, x, y, pw, h, h/2, SDL_MapRGB(dst->format, 0xDC, 0x26, 0x26));
+			SDL_BlitSurface(ws, NULL, dst, &(SDL_Rect){x + 7*u, y + (h - ws->h)/2});
+			SDL_FreeSurface(ws);
+			used += pw + 6*u;
+		}
+	}
+	return used;
+}
+
+// ---- helpers shared with minui / minarch ----
+void GFX_fillRound(SDL_Surface* dst, int x, int y, int w, int h, int r, Uint32 c) { UI_fillRound(dst, x, y, w, h, r, c); }
+void GFX_drawBackdrop(SDL_Surface* dst) { SB_gradient(dst); }
+
+// bright colour for a console name (same rule as the tiles of the main menu)
+void GFX_consoleColor(const char* name, int* r, int* g, int* b, int* dark_text) {
+	static const unsigned char palette[8][3] = {
+		{0xA3,0xE6,0x35}, {0x7C,0x3A,0xED}, {0x4F,0x46,0xE5}, {0xDC,0x26,0x26},
+		{0x06,0xB6,0xD4}, {0xF9,0x73,0x16}, {0xEC,0x48,0x99}, {0x10,0xB9,0x81},
+	};
+	unsigned h = 2166136261u;
+	for (const char* p=name; *p; p++) { h ^= (unsigned char)*p; h *= 16777619u; }
+	const unsigned char* c = palette[h % 8];
+	*r=c[0]; *g=c[1]; *b=c[2];
+	*dark_text = (c[0]*299 + c[1]*587 + c[2]*114) > 140000;
+}
