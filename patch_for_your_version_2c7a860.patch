--- a/workspace/all/minui/minui.c
+++ b/workspace/all/minui/minui.c
@@ -1,4 +1,5 @@
 #include <stdio.h>
+#include <math.h>
 #include <stdlib.h>
 #include <msettings.h>
 #include <sys/types.h>
@@ -1704,6 +1705,316 @@ static void Menu_quit(void) {
 
 ///////////////////////////////////////
 
+/////////////////////////////////////////////////////////////////
+// Tile (grid) main menu
+/////////////////////////////////////////////////////////////////
+#define TILE_COLS 3
+#define TILE_ROWS 2
+#define TILE_PER_PAGE (TILE_COLS*TILE_ROWS)
+
+static int Tile_pack(SDL_Surface* dst, int r, int g, int b) { return SDL_MapRGB(dst->format, r, g, b); }
+
+// filled rounded rectangle using only SDL_FillRect (works for any pixel format)
+static void Tile_fillRound(SDL_Surface* dst, int x, int y, int w, int h, int r, Uint32 c) {
+	if (w<=0 || h<=0) return;
+	if (r*2>h) r = h/2;
+	if (r*2>w) r = w/2;
+	for (int dy=0; dy<r; dy++) {
+		// horizontal inset for this row (circle of radius r)
+		int inset = 0;
+		{
+			int yy = 2*(r-dy)-1; // twice the distance from circle centre to row centre
+			int lim = 4*r*r - yy*yy;
+			int k = 0;
+			while ((2*(k+1))*(2*(k+1)) <= lim) k++;
+			inset = r - k;
+		}
+		SDL_FillRect(dst, &(SDL_Rect){x+inset, y+dy, w-inset*2, 1}, c);
+		SDL_FillRect(dst, &(SDL_Rect){x+inset, y+h-1-dy, w-inset*2, 1}, c);
+	}
+	SDL_FillRect(dst, &(SDL_Rect){x, y+r, w, h-r*2}, c);
+}
+
+static const unsigned char tile_palette[][3] = {
+	{0xA3,0xE6,0x35}, // lime
+	{0x7C,0x3A,0xED}, // violet
+	{0x4F,0x46,0xE5}, // indigo
+	{0xDC,0x26,0x26}, // red
+	{0x06,0xB6,0xD4}, // cyan
+	{0xF9,0x73,0x16}, // orange
+	{0xEC,0x48,0x99}, // pink
+	{0x10,0xB9,0x81}, // green
+};
+
+static void Tile_color(Entry* e, int* r, int* g, int* b, int* dark_text) {
+	const unsigned char* c;
+	static const unsigned char recent[3] = {0xFF,0x4D,0x6D};
+	static const unsigned char fav[3] = {0xFF,0xB7,0x03};
+	static const unsigned char tools[3] = {0x38,0xBD,0xF8};
+	if (exactMatch(e->path, FAUX_RECENT_PATH)) c = recent;
+	else if (exactMatch(e->path, FAUX_FAVORITE_PATH)) c = fav;
+	else if (e->type==ENTRY_PAK) c = tools;
+	else {
+		unsigned h = 2166136261u;
+		for (const char* p=e->name; *p; p++) { h ^= (unsigned char)*p; h *= 16777619u; }
+		c = tile_palette[h % (sizeof(tile_palette)/sizeof(tile_palette[0]))];
+	}
+	*r=c[0]; *g=c[1]; *b=c[2];
+	// light colours get dark text
+	*dark_text = (c[0]*299 + c[1]*587 + c[2]*114) > 140000;
+}
+
+static int Tile_charLen(const char* s) {
+	unsigned char c = (unsigned char)*s;
+	if (c<0x80) return 1;
+	if ((c&0xE0)==0xC0) return 2;
+	if ((c&0xF0)==0xE0) return 3;
+	if ((c&0xF8)==0xF0) return 4;
+	return 1;
+}
+
+// short label for the big text in the tile: initials of words, or first letters
+static void Tile_abbrev(const char* name, char* out, int out_size) {
+	out[0] = '\0';
+	int n = 0, words = 0;
+	const char* p = name;
+	int at_start = 1;
+	// count words
+	for (const char* q=name; *q; q++) { if (*q==' ') at_start = 1; else if (at_start) { words++; at_start = 0; } }
+	if (words>=2) {
+		at_start = 1;
+		while (*p && n<3) {
+			int len = Tile_charLen(p);
+			if (*p==' ') at_start = 1;
+			else if (at_start) {
+				if (n+len>=out_size-1) break;
+				if (len==1 && !((*p>='A'&&*p<='Z')||(*p>='a'&&*p<='z')||(*p>='0'&&*p<='9'))) { at_start = 0; p += len; continue; }
+				memcpy(out+n, p, len); n += len; out[n] = '\0';
+				at_start = 0;
+				if (len==1 && *p>='a' && *p<='z') out[n-1] -= 32;
+				// count at most 3 initials
+			}
+			p += len;
+			// stop condition: count initials not bytes
+			int initials = 0;
+			for (const char* t=out; *t; t += Tile_charLen(t)) initials++;
+			if (initials>=3) break;
+		}
+	}
+	if (!out[0]) {
+		int initials = 0;
+		p = name;
+		while (*p && initials<3 && n+Tile_charLen(p)<out_size-1) {
+			int len = Tile_charLen(p);
+			memcpy(out+n, p, len); n += len; out[n] = '\0';
+			if (len==1 && out[n-1]>='a' && out[n-1]<='z') out[n-1] -= 32;
+			p += len; initials++;
+		}
+	}
+}
+
+// ---- background and console icons ----
+static void Tile_background(SDL_Surface* dst) {
+	// dark blue vertical gradient instead of plain black
+	int h = dst->h;
+	for (int y=0; y<h; y++) {
+		int r = 11 + (22-11)*y/h;
+		int g = 16 + (28-16)*y/h;
+		int b = 40 + (70-40)*y/h;
+		SDL_FillRect(dst, &(SDL_Rect){0,y,dst->w,1}, SDL_MapRGB(dst->format, r, g, b));
+	}
+}
+
+static int Tile_has(const char* name, const char* needle) {
+	int nl = strlen(needle);
+	for (const char* p=name; *p; p++) {
+		int k = 0;
+		while (k<nl && p[k]) {
+			char c = p[k];
+			if (c>='A' && c<='Z') c += 32;
+			if (c!=needle[k]) break;
+			k++;
+		}
+		if (k==nl) return 1;
+	}
+	return 0;
+}
+
+enum { TILE_ICON_PAD, TILE_ICON_HANDHELD, TILE_ICON_CLOCK, TILE_ICON_STAR, TILE_ICON_GEAR };
+
+static int Tile_iconKind(Entry* e, const char* name) {
+	if (exactMatch(e->path, FAUX_RECENT_PATH)) return TILE_ICON_CLOCK;
+	if (exactMatch(e->path, FAUX_FAVORITE_PATH)) return TILE_ICON_STAR;
+	if (e->type==ENTRY_PAK) return TILE_ICON_GEAR;
+	if (Tile_has(name,"boy") || Tile_has(name,"gba") || Tile_has(name,"gbc") || Tile_has(name,"lynx") ||
+		Tile_has(name,"game gear") || Tile_has(name,"pocket") || Tile_has(name,"wonderswan") || Tile_has(name,"psp") ||
+		Tile_has(name,"vita") || Tile_has(name,"nintendo ds") || Tile_has(name,"3ds") || Tile_has(name,"handheld"))
+		return TILE_ICON_HANDHELD;
+	return TILE_ICON_PAD;
+}
+
+// draws an icon inside the square (x,y,sz,sz)
+static void Tile_icon(SDL_Surface* d, int x, int y, int sz, int kind, Uint32 bg) {
+	Uint32 white = SDL_MapRGB(d->format, 255,255,255);
+	Uint32 navy = SDL_MapRGB(d->format, 0x0B,0x10,0x20);
+	Uint32 red = SDL_MapRGB(d->format, 0xE1,0x1D,0x48);
+	Uint32 yellow = SDL_MapRGB(d->format, 0xFB,0xBF,0x24);
+	Uint32 blue = SDL_MapRGB(d->format, 0x25,0x63,0xEB);
+	Uint32 green = SDL_MapRGB(d->format, 0x16,0xA3,0x4A);
+	int u = sz/16; if (u<1) u = 1;
+	if (kind==TILE_ICON_HANDHELD) {
+		int bw = sz*12/16, bh = sz;
+		int bx = x + (sz-bw)/2, by = y;
+		Tile_fillRound(d, bx, by, bw, bh, 2*u, white);
+		Tile_fillRound(d, bx+u*1, by+u*1, bw-u*2, bh-u*2, 2*u, SDL_MapRGB(d->format, 0xE5,0xE7,0xEB));
+		Tile_fillRound(d, bx+2*u, by+2*u, bw-4*u, 6*u, u, navy);
+		Tile_fillRound(d, bx+3*u, by+3*u, bw-6*u, 4*u, u, SDL_MapRGB(d->format, 0x4A,0xDE,0x80));
+		// d-pad
+		int cx = bx+4*u, cy = by+12*u;
+		SDL_FillRect(d, &(SDL_Rect){cx-u, cy-3*u, 2*u, 6*u}, navy);
+		SDL_FillRect(d, &(SDL_Rect){cx-3*u, cy-u, 6*u, 2*u}, navy);
+		// buttons
+		Tile_fillRound(d, bx+bw-5*u, cy-2*u, 3*u, 3*u, 2*u, red);
+		Tile_fillRound(d, bx+bw-7*u-u/2, cy+u, 3*u, 3*u, 2*u, blue);
+	}
+	else if (kind==TILE_ICON_PAD) {
+		int bw = sz, bh = sz*10/16;
+		int bx = x, by = y + (sz-bh)/2;
+		Tile_fillRound(d, bx, by, bw, bh, 4*u, white);
+		Tile_fillRound(d, bx+u, by+u, bw-2*u, bh-2*u, 4*u, SDL_MapRGB(d->format, 0xE5,0xE7,0xEB));
+		int cx = bx+4*u, cy = by+bh/2;
+		SDL_FillRect(d, &(SDL_Rect){cx-u, cy-3*u, 2*u+u/2+1, 6*u}, navy);
+		SDL_FillRect(d, &(SDL_Rect){cx-3*u, cy-u, 6*u, 2*u+u/2+1}, navy);
+		Tile_fillRound(d, bx+bw-8*u, cy-u-2*u, 3*u, 3*u, 2*u, yellow);
+		Tile_fillRound(d, bx+bw-5*u, cy-u, 3*u, 3*u, 2*u, red);
+		Tile_fillRound(d, bx+bw-8*u, cy+u, 3*u, 3*u, 2*u, green);
+		Tile_fillRound(d, bx+bw-11*u, cy-u, 3*u, 3*u, 2*u, blue);
+	}
+	else if (kind==TILE_ICON_CLOCK) {
+		Tile_fillRound(d, x, y, sz, sz, sz/2, navy);
+		Tile_fillRound(d, x+2*u, y+2*u, sz-4*u, sz-4*u, (sz-4*u)/2, bg);
+		SDL_FillRect(d, &(SDL_Rect){x+sz/2-u, y+3*u+u, 2*u, sz/2-3*u}, navy);
+		SDL_FillRect(d, &(SDL_Rect){x+sz/2-u, y+sz/2-u, 4*u+u, 2*u}, navy);
+	}
+	else if (kind==TILE_ICON_STAR) {
+		// 5-point star: scanline fill of the polygon (even-odd) with 10 vertices
+		float px[10], py[10];
+		float cx = x + sz/2.0f, cy = y + sz*0.55f, R = sz*0.55f, r = R*0.42f;
+		for (int i=0; i<10; i++) {
+			float ang = -3.14159265f/2 + i*3.14159265f/5;
+			float rad = (i%2==0) ? R : r;
+			px[i] = cx + rad*cosf(ang);
+			py[i] = cy + rad*sinf(ang);
+		}
+		for (int row=0; row<sz; row++) {
+			float yy = y + row + 0.5f;
+			float xs[10]; int n = 0;
+			for (int i=0; i<10; i++) {
+				int j = (i+1)%10;
+				if ((py[i]<=yy && py[j]>yy) || (py[j]<=yy && py[i]>yy)) {
+					xs[n++] = px[i] + (yy-py[i])*(px[j]-px[i])/(py[j]-py[i]);
+				}
+			}
+			for (int a=0; a<n; a++) for (int b2=a+1; b2<n; b2++) if (xs[b2]<xs[a]) { float t=xs[a]; xs[a]=xs[b2]; xs[b2]=t; }
+			for (int a=0; a+1<n; a+=2) SDL_FillRect(d, &(SDL_Rect){(int)xs[a], y+row, (int)(xs[a+1]-xs[a])+1, 1}, navy);
+		}
+	}
+	else { // gear
+		Tile_fillRound(d, x+3*u, y+3*u, sz-6*u, sz-6*u, (sz-6*u)/2, navy);
+		SDL_FillRect(d, &(SDL_Rect){x+sz/2-u-u/2, y, 3*u, sz}, navy);
+		SDL_FillRect(d, &(SDL_Rect){x, y+sz/2-u-u/2, sz, 3*u}, navy);
+		Tile_fillRound(d, x+6*u, y+6*u, sz-12*u, sz-12*u, (sz-12*u)/2, bg);
+	}
+}
