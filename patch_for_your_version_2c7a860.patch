+#ifndef I18N_H
+#define I18N_H
+
+// Runtime translation. Dictionary file: <sdcard>/.system/res/lang.txt
+// Format, one entry per line:   English text => Русский текст
+// Lines starting with # are comments. Missing file or missing entry = original text.
+// If the dictionary contains the line   #log   every text that has no translation is
+// appended to <sdcard>/.userdata/shared/untranslated.txt (one per line, no duplicates).
+
+const char* I18N_T(const char* text);
+
+// Every text measured or drawn through SDL_ttf passes through the dictionary.
+// A function-like macro is not re-expanded inside its own expansion, so the
+// inner name below is the real SDL_ttf function.
+#ifdef TTF_RenderUTF8_Blended
+#undef TTF_RenderUTF8_Blended
+#endif
+#ifdef TTF_SizeUTF8
+#undef TTF_SizeUTF8
+#endif
+#define TTF_RenderUTF8_Blended(font, text, color) TTF_RenderUTF8_Blended((font), I18N_T(text), (color))
+#define TTF_SizeUTF8(font, text, w, h) TTF_SizeUTF8((font), I18N_T(text), (w), (h))
+
+#endif
diff --git a/workspace/all/common/i18n_impl.h b/workspace/all/common/i18n_impl.h
new file mode 100644
index 0000000..04b23d3
--- /dev/null
+++ b/workspace/all/common/i18n_impl.h
@@ -0,0 +1,154 @@
+// Implementation of the runtime dictionary (included once, from api.c).
+// Kept separate from api.c so it can be unit-tested on a PC.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef I18N_DICT_PATH
+#define I18N_DICT_PATH RES_PATH "/lang.txt"
+#endif
+#ifndef I18N_LOG_PATH
+#define I18N_LOG_PATH SHARED_USERDATA_PATH "/untranslated.txt"
+#endif
+
+typedef struct {
+	char* key;
+	char* val;
+} I18N_Entry;
+
+static struct {
+	int loaded;
+	int logging;
+	char* data;          // whole file, modified in place
+	I18N_Entry* table;   // open addressing, size is a power of two
+	unsigned size;
+	unsigned count;
+	// misses already logged this session (to avoid duplicates)
+	char** seen;
+	unsigned seen_count;
+	unsigned seen_cap;
+} i18n;
+
+static unsigned I18N_hash(const char* s) {
+	unsigned h = 2166136261u;
+	while (*s) {
+		h ^= (unsigned char)*s++;
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void I18N_insert(char* key, char* val) {
+	unsigned i = I18N_hash(key) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, key)) { // later entry wins
+			i18n.table[i].val = val;
+			return;
+		}
+		i = (i + 1) & (i18n.size - 1);
+	}
+	i18n.table[i].key = key;
+	i18n.table[i].val = val;
+	i18n.count++;
+}
+
+static char* I18N_trim(char* s) {
+	while (*s==' ' || *s=='\t') s++;
+	char* e = s + strlen(s);
+	while (e>s && (e[-1]==' ' || e[-1]=='\t')) *--e = '\0';
+	return s;
+}
+
+static void I18N_load(void) {
+	i18n.loaded = 1;
+	FILE* f = fopen(I18N_DICT_PATH, "rb");
+	if (!f) return;
+	fseek(f, 0, SEEK_END);
+	long len = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	if (len<=0 || len>(4L*1024*1024)) { fclose(f); return; }
+	i18n.data = malloc(len + 1);
+	if (!i18n.data) { fclose(f); return; }
+	size_t got = fread(i18n.data, 1, len, f);
+	fclose(f);
+	i18n.data[got] = '\0';
+
+	char* p = i18n.data;
+	if ((unsigned char)p[0]==0xEF && (unsigned char)p[1]==0xBB && (unsigned char)p[2]==0xBF) p += 3; // BOM
+
+	// count lines to size the table
+	unsigned lines = 1;
+	for (char* c = p; *c; c++) if (*c=='\n') lines++;
+	unsigned size = 64;
+	while (size < lines * 2) size <<= 1;
+	i18n.table = calloc(size, sizeof(I18N_Entry));
+	if (!i18n.table) { free(i18n.data); i18n.data = NULL; return; }
+	i18n.size = size;
+
+	while (*p) {
+		char* eol = strchr(p, '\n');
+		if (eol) *eol = '\0';
+		char* next = eol ? eol + 1 : p + strlen(p);
+
+		size_t l = strlen(p);
+		if (l && p[l-1]=='\r') p[l-1] = '\0';
+
+		if (p[0]=='#') {
+			if (!strcmp(I18N_trim(p), "#log")) i18n.logging = 1;
+		}
+		else if (p[0]) {
+			char* sep = strstr(p, " => ");
+			if (sep) {
+				*sep = '\0';
+				char* key = I18N_trim(p);
+				char* val = I18N_trim(sep + 4);
+				if (key[0] && val[0]) I18N_insert(key, val);
+			}
+		}
+		p = next;
+	}
+}
+
+static void I18N_logMiss(const char* text) {
+	for (unsigned i=0; i<i18n.seen_count; i++) {
+		if (!strcmp(i18n.seen[i], text)) return;
+	}
+	if (i18n.seen_count==i18n.seen_cap) {
+		unsigned cap = i18n.seen_cap ? i18n.seen_cap * 2 : 128;
+		char** grown = realloc(i18n.seen, cap * sizeof(char*));
+		if (!grown) return;
+		i18n.seen = grown;
+		i18n.seen_cap = cap;
+	}
+	char* copy = strdup(text);
+	if (!copy) return;
+	i18n.seen[i18n.seen_count++] = copy;
+
+	FILE* f = fopen(I18N_LOG_PATH, "ab");
+	if (!f) return;
+	fprintf(f, "%s\n", text);
+	fclose(f);
+}
+
+static int I18N_hasLetters(const char* s) {
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if ((c>='A' && c<='Z') || (c>='a' && c<='z')) return 1;
+	}
+	return 0;
+}
+
+const char* I18N_T(const char* text) {
+	if (!text || !text[0]) return text;
+	if (!i18n.loaded) I18N_load();
+	if (!i18n.table) return text;
+
+	unsigned i = I18N_hash(text) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, text)) return i18n.table[i].val;
+		i = (i + 1) & (i18n.size - 1);
+	}
+	if (i18n.logging && I18N_hasLetters(text)) I18N_logMiss(text);
+	return text;
+}
diff --git a/workspace/all/common/standby_impl.h b/workspace/all/common/standby_impl.h
new file mode 100644
index 0000000..b422b22
--- /dev/null
+++ b/workspace/all/common/standby_impl.h
@@ -0,0 +1,150 @@
+// Standby screen (clock + animation) shown before the real sleep.
+// Included from api.c.
+//  - Disable:  create empty file  .userdata/shared/disable-standby
+//  - Own animation: PNG frames  .system/res/standby/0.png, 1.png, 2.png ...  (up to 60)
+//    optional  .system/res/standby/delay.txt  with delay between frames in ms (default 100)
+#include <time.h>
+
+#define STANDBY_DISABLE_PATH SHARED_USERDATA_PATH "/disable-standby"
+#define STANDBY_DIR RES_PATH "/standby"
+#define STANDBY_MAX_FRAMES 60
+#define STANDBY_SECONDS 20 // when not charging; while charging it stays on
+
+static void SB_circle(SDL_Surface* d, int cx, int cy, int r, Uint32 c) {
+	for (int dy=-r; dy<=r; dy++) {
+		int w = (int)sqrtf((float)(r*r - dy*dy));
+		SDL_FillRect(d, &(SDL_Rect){cx-w, cy+dy, w*2+1, 1}, c);
+	}
+}
+
+// gradient background with slowly drifting coloured blobs (no files needed)
+static void SB_drawBackground(SDL_Surface* d, unsigned ms) {
+	int W = d->w, H = d->h;
+	for (int y=0; y<H; y++) {
+		int r = 11 + (22-11)*y/H;
+		int g = 16 + (28-16)*y/H;
+		int b = 40 + (70-40)*y/H;
+		SDL_FillRect(d, &(SDL_Rect){0,y,W,1}, SDL_MapRGB(d->format, r, g, b));
+	}
+	static const unsigned char col[5][3] = {
+		{0x4B,0x6E,0x16}, {0x45,0x28,0x84}, {0x7A,0x2A,0x52}, {0x0B,0x6B,0x7A}, {0x8A,0x4A,0x12}
+	};
+	float t = ms / 1000.0f;
+	for (int i=0; i<5; i++) {
+		float fx = 0.23f + 0.07f*i, fy = 0.19f + 0.05f*i;
+		int cx = W/2 + (int)(W*0.38f*sinf(t*fx + i*1.7f));
+		int cy = H/2 + (int)(H*0.34f*cosf(t*fy + i*2.3f));
+		int r = H/6 + (int)(H/30*sinf(t*0.9f + i));
+		SB_circle(d, cx, cy, r, SDL_MapRGB(d->format, col[i][0], col[i][1], col[i][2]));
+	}
+}
+
+static SDL_Surface* SB_text(TTF_Font* f, const char* s, SDL_Color c) {
+	return (TTF_RenderUTF8_Blended)(f, s, c); // parentheses: skip the translation macro
+}
+
+static void SB_blitCentered(SDL_Surface* d, TTF_Font* f, const char* s, int y, SDL_Color c) {
+	int sh = f==NULL ? 0 : 2*FIXED_SCALE/2;
+	SDL_Surface* t = SB_text(f, s, (SDL_Color){0,0,0});
+	if (t) { SDL_BlitSurface(t, NULL, d, &(SDL_Rect){(d->w-t->w)/2+sh+1, y+sh+1}); SDL_FreeSurface(t); }
+	t = SB_text(f, s, c);
+	if (t) { SDL_BlitSurface(t, NULL, d, &(SDL_Rect){(d->w-t->w)/2, y}); SDL_FreeSurface(t); }
+}
+
+static int SB_loadFrames(SDL_Surface** frames) {
+	int n = 0;
+	char path[256];
+	while (n<STANDBY_MAX_FRAMES) {
+		snprintf(path, sizeof(path), STANDBY_DIR "/%d.png", n);
+		if (access(path, F_OK)!=0) break;
+		SDL_Surface* s = IMG_Load(path);
+		if (!s) break;
+		SDL_Surface* c = SDL_ConvertSurface(s, gfx.screen->format, 0);
+		SDL_FreeSurface(s);
+		if (!c) break;
+		frames[n++] = c;
+	}
+	return n;
+}
+
+static void SB_blitFrame(SDL_Surface* d, SDL_Surface* f) {
+	// "cover": fill the screen keeping the aspect ratio, crop the rest
+	SDL_Rect src = {0,0,f->w,f->h};
+	if ((long)f->w*d->h > (long)f->h*d->w) { // frame is wider
+		src.w = (int)((long)f->h*d->w/d->h);
+		src.x = (f->w-src.w)/2;
+	} else {
+		src.h = (int)((long)f->w*d->h/d->w);
+		src.y = (f->h-src.h)/2;
+	}
+	SDL_BlitScaled(f, &src, d, &(SDL_Rect){0,0,d->w,d->h});
+}
+
+// returns 1 if the user woke the device while the clock was shown, 0 if time ran out
+static int Standby_show(void) {
+	if (GetHDMI() || exists(STANDBY_DISABLE_PATH)) return 0;
+
+	SDL_Surface* screen = gfx.screen;
+	SDL_PauseAudio(1);
+
+	TTF_Font* big = TTF_OpenFont(FONT_PATH, SCALE1(44));
+	if (!big) big = font.large;
+
+	SDL_Surface* frames[STANDBY_MAX_FRAMES];
+	int nframes = SB_loadFrames(frames);
+	int delay = 100;
+	{
+		FILE* f = fopen(STANDBY_DIR "/delay.txt", "r");
+		if (f) { int v = 0; if (fscanf(f, "%d", &v)==1 && v>=20 && v<=2000) delay = v; fclose(f); }
+	}
+
+	static const char* wd[] = {"воскресенье","понедельник","вторник","среда","четверг","пятница","суббота"};
+	static const char* mo[] = {"января","февраля","марта","апреля","мая","июня","июля","августа","сентября","октября","ноября","декабря"};
+
+	while (SDL_PollEvent(&(SDL_Event){0})) {} // drop old events
+	uint32_t start = SDL_GetTicks();
+	uint32_t checked = start;
+	int charging = pwr.is_charging;
+	int woke = 0;
+
+	while (1) {
+		SDL_Event ev;
+		while (SDL_PollEvent(&ev)) {
+			if (ev.type==SDL_KEYDOWN || ev.type==SDL_JOYBUTTONDOWN) woke = 1;
+		}
+		if (woke) break;
+
+		uint32_t now = SDL_GetTicks();
+		if (now-checked>=2000) {
+			int ch = 0, lvl = 0;
+			PLAT_getBatteryStatus(&ch, &lvl);
+			charging = ch;
+			checked = now;
+		}
+		if (!charging && now-start>=STANDBY_SECONDS*1000) break;
+
+		if (nframes>0) SB_blitFrame(screen, frames[((now-start)/delay) % nframes]);
+		else SB_drawBackground(screen, now-start);
+
+		time_t tt = time(NULL);
+		struct tm* lt = localtime(&tt);
+		char buf[64];
+		if (lt) {
+			snprintf(buf, sizeof(buf), "%02d:%02d", lt->tm_hour, lt->tm_min);
+			SB_blitCentered(screen, big, buf, screen->h*30/100, (SDL_Color){255,255,255});
+			snprintf(buf, sizeof(buf), "%s, %d %s", wd[lt->tm_wday%7], lt->tm_mday, mo[lt->tm_mon%12]);
+			SB_blitCentered(screen, font.large, buf, screen->h*30/100 + SCALE1(54), (SDL_Color){0xE5,0xE7,0xEB});
+		}
+		if (charging) SB_blitCentered(screen, font.small, "Заряжается", screen->h - SCALE1(34), (SDL_Color){0xA3,0xE6,0x35});
+
+		GFX_flip(screen);
+		GFX_pan();
+		SDL_Delay(50);
+	}
+
+	for (int i=0; i<nframes; i++) SDL_FreeSurface(frames[i]);
+	if (big!=font.large) TTF_CloseFont(big);
+	if (woke) SDL_PauseAudio(0);
+	return woke;
+}
+
