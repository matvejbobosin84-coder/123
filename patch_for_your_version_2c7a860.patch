+// Small drawing helpers shared by the new UI parts (included from api.c)
+
+// filled rounded rectangle using only SDL_FillRect (works for any pixel format)
+static void UI_fillRound(SDL_Surface* dst, int x, int y, int w, int h, int r, Uint32 c) {
+	if (w<=0 || h<=0) return;
+	if (r*2>h) r = h/2;
+	if (r*2>w) r = w/2;
+	for (int dy=0; dy<r; dy++) {
+		int yy = 2*(r-dy)-1;
+		int lim = 4*r*r - yy*yy;
+		int k = 0;
+		while ((2*(k+1))*(2*(k+1)) <= lim) k++;
+		int inset = r - k;
+		SDL_FillRect(dst, &(SDL_Rect){x+inset, y+dy, w-inset*2, 1}, c);
+		SDL_FillRect(dst, &(SDL_Rect){x+inset, y+h-1-dy, w-inset*2, 1}, c);
+	}
+	SDL_FillRect(dst, &(SDL_Rect){x, y+r, w, h-r*2}, c);
+}
+
+// text without the translation macro (numbers, clock, ...)
+static SDL_Surface* UI_text(TTF_Font* f, const char* s, SDL_Color c) {
+	return (TTF_RenderUTF8_Blended)(f, s, c);
+}
+static int UI_textWidth(TTF_Font* f, const char* s) {
+	int w = 0;
+	(TTF_SizeUTF8)(f, s, &w, NULL);
+	return w;
+}
+
+// ---- battery: rounded icon with coloured fill + percentage ----
+static int UI_batteryTextWidth(void) {
+	return UI_textWidth(font.tiny, "100%");
+}
+// total width of the battery block (icon + text)
+static int UI_batteryWidth(void) {
+	int u = FIXED_SCALE;
+	return 6*u + 22*u + 2*u + 4*u + UI_batteryTextWidth() + 6*u;
+}
+
+static void UI_drawBattery(SDL_Surface* dst, int x, int y, int cell_h, int with_text) {
+	if (!dst) return; // the overlay surface does not exist on some platforms
+	int u = FIXED_SCALE;
+	int pct = pwr.charge;
+	if (pct<0) pct = 0;
+	if (pct>100) pct = 100;
+	int bw = 22*u, bh = 11*u;
+	int bx = x + (with_text ? 6*u : (cell_h - bw)/2);
+	int by = y + (cell_h - bh)/2;
+
+	Uint32 rim   = SDL_MapRGB(dst->format, 0xE5,0xE7,0xEB);
+	Uint32 inner = SDL_MapRGB(dst->format, 0x1F,0x29,0x37);
+	Uint32 col;
+	if (pwr.is_charging || pct>=50) col = SDL_MapRGB(dst->format, 0x4A,0xDE,0x80);
+	else if (pct>=20)               col = SDL_MapRGB(dst->format, 0xFB,0xBF,0x24);
+	else                            col = SDL_MapRGB(dst->format, 0xF8,0x71,0x71);
+
+	UI_fillRound(dst, bx, by, bw, bh, 3*u, rim);
+	UI_fillRound(dst, bx+u, by+u, bw-2*u, bh-2*u, 2*u, inner);
+	SDL_FillRect(dst, &(SDL_Rect){bx+bw, by+bh/4, 2*u, bh/2}, rim);
+
+	int fw = (bw-4*u) * pct / 100;
+	if (pct>0 && fw<2*u) fw = 2*u;
+	UI_fillRound(dst, bx+2*u, by+2*u, fw, bh-4*u, u, col);
+
+	if (pwr.is_charging) {
+		// lightning bolt (6x10 bitmap) in the middle of the icon
+		static const char* bolt[10] = {
+			"...###", "..###.", ".###..", "######", "..###.",
+			".###..", "###...", "##....", "#.....", "......"
+		};
+		int s = u>1 ? u/2 : 1; if (s<1) s = 1;
+		int ox = bx + (bw - 6*s)/2, oy = by + (bh - 9*s)/2;
+		Uint32 dark = SDL_MapRGB(dst->format, 0xFF,0xFF,0xFF);
+		for (int r=0; r<9; r++) for (int c=0; c<6; c++) if (bolt[r][c]=='#')
+			SDL_FillRect(dst, &(SDL_Rect){ox+c*s, oy+r*s, s, s}, dark);
+	}
+
+	if (with_text) {
+		char buf[8];
+		snprintf(buf, sizeof(buf), "%d%%", pct);
+		SDL_Surface* t = UI_text(font.tiny, buf, (SDL_Color){255,255,255});
+		if (t) {
+			SDL_BlitSurface(t, NULL, dst, &(SDL_Rect){bx+bw+2*u+4*u, y+(cell_h-t->h)/2});
+			SDL_FreeSurface(t);
+		}
+	}
+}
