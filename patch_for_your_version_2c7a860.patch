+static void Tile_draw(SDL_Surface* screen, Directory* dir, int total) {
+	if (!tile_big_font) {
+		tile_big_font = TTF_OpenFont(FONT_PATH, SCALE1(24));
+		if (!tile_big_font) tile_big_font = font.large;
+	}
+	int W = screen->w, H = screen->h;
+	int s = W/320; if (s<1) s = 1; // pixel unit (same as SCALE1 on 640 wide)
+	int margin = 12*s;
+	int gap = 7*s;
+	int top_y = 40*s;
+	int bottom_reserved = 42*s; // hint row + dots
+	int cell_w = (W - margin*2 - gap*(TILE_COLS-1)) / TILE_COLS;
+	int cell_h = (H - top_y - bottom_reserved - 6*s - gap*(TILE_ROWS-1)) / TILE_ROWS;
+	int radius = 10*s;
+
+	int selected = dir->selected;
+	int page = selected / TILE_PER_PAGE;
+	int pages = (total + TILE_PER_PAGE - 1) / TILE_PER_PAGE;
+	int first = page * TILE_PER_PAGE;
+
+	// title + page counter
+	char title[64];
+	int mr, mg, mb, dr, dg, db, br_, bg_, bb_;
+	GFX_themeColor(1, &mr, &mg, &mb);
+	GFX_themeColor(2, &dr, &dg, &db);
+	{ int a, b2, c2; GFX_themeColor(3, &a, &b2, &c2); br_ = a; bg_ = b2; bb_ = c2; }
+	int title_w = 0;
+	SDL_Surface* t = TTF_RenderUTF8_Blended(font.large, "Main Menu", COLOR_WHITE);
+	if (t) { title_w = t->w; SDL_BlitSurface(t, NULL, screen, &(SDL_Rect){margin, 10*s}); SDL_FreeSurface(t); }
+	if (pages>0) {
+		snprintf(title, sizeof(title), "%d / %d", selected+1, total);
+		SDL_Color cnt_color = {mr, mg, mb};
+		SDL_Surface* c = TTF_RenderUTF8_Blended(font.small, title, cnt_color);
+		if (c) { SDL_BlitSurface(c, NULL, screen, &(SDL_Rect){margin + title_w + 10*s, 14*s}); SDL_FreeSurface(c); }
+	}
+	GFX_drawStatusExtras(screen, W - tile_battery_w - 8*s, 8*s, 24*s, 1);
+
+	// selection animation: the new tile grows, the old one shrinks back
+	unsigned now_ms = SDL_GetTicks();
+	if (tile_last_sel<0) { tile_anim_start = now_ms - 1000; tile_prev_sel = -1; }
+	else if (selected!=tile_last_sel) {
+		tile_prev_sel = (tile_last_sel/TILE_PER_PAGE==page) ? tile_last_sel : -1;
+		tile_anim_start = now_ms;
+	}
+	tile_last_sel = selected;
+	int gsel = 100;
+	tile_animating = 0;
+	if (now_ms - tile_anim_start < TILE_ANIM_MS) {
+		int p100 = (int)((now_ms - tile_anim_start) * 100 / TILE_ANIM_MS);
+		gsel = p100*p100*(300-2*p100)/10000; // smoothstep
+		tile_animating = 1;
+	}
+
+	for (int k=0; k<TILE_PER_PAGE; k++) {
+		int i = first + k;
+		if (i>=total) break;
+		Entry* e = dir->entries->items[i];
+		int col = k % TILE_COLS, row = k / TILE_COLS;
+		int x = margin + col*(cell_w+gap);
+		int y = top_y + row*(cell_h+gap);
+		int w = cell_w, h = cell_h;
+		int g = (i==selected) ? gsel : (i==tile_prev_sel ? 100-gsel : 0);
+		int cr, cg, cb, dark;
+		Tile_color(e, &cr, &cg, &cb, &dark);
+		int dr_ = (cr*70+br_*30)/100, dg_ = (cg*70+bg_*30)/100, db_ = (cb*70+bb_*30)/100;
+		int tr = dr_ + (cr-dr_)*g/100, tg = dg_ + (cg-dg_)*g/100, tb = db_ + (cb-db_)*g/100;
+		{
+			int o = 3*s*g/100, ex = s*g/100;
+			if (o>0) Tile_fillRound(screen, x-o-ex, y-o-ex, w+(o+ex)*2, h+(o+ex)*2, radius+o, Tile_pack(screen, 255,255,255));
+			Tile_fillRound(screen, x-ex, y-ex, w+ex*2, h+ex*2, radius+ex, Tile_pack(screen, tr, tg, tb));
+		}
+		SDL_Color tc = dark ? (SDL_Color){0x0B,0x10,0x20} : (SDL_Color){0xFF,0xFF,0xFF};
+
+		char* name = e->name;
+		trimSortingMeta(&name);
+		{
+			int isz = h*40/100;
+			Tile_icon(screen, x+w-isz-9*s, y+8*s, isz, Tile_iconKind(e, name), Tile_pack(screen, tr, tg, tb));
+		}
+		char abbr[16];
+		Tile_abbrev(name, abbr, sizeof(abbr));
+		SDL_Surface* big = TTF_RenderUTF8_Blended(tile_big_font, abbr, tc);
+		int abbr_bottom = y + 8*s;
+		if (big) { abbr_bottom += big->h; SDL_BlitSurface(big, NULL, screen, &(SDL_Rect){x+9*s, y+8*s}); SDL_FreeSurface(big); }
+
+		char shown[256];
+		int name_top = y + h - TTF_FontHeight(font.medium) - 8*s;
+		int reserve = 0; // width taken by the counter when it has to sit on the name row
+		{
+			// game counter: right under the abbreviation if there is room, otherwise just the number at the right of the name row
+			int cnt = Tile_count(e);
+			if (cnt>0) {
+				char cs[48];
+				snprintf(cs, sizeof(cs), "%d %s", cnt, Tile_plural(cnt));
+				SDL_Surface* ct = (TTF_RenderUTF8_Blended)(font.small, cs, tc);
+				if (ct && abbr_bottom + ct->h <= name_top) {
+					SDL_BlitSurface(ct, NULL, screen, &(SDL_Rect){x+9*s, abbr_bottom});
+				}
+				else {
+					if (ct) SDL_FreeSurface(ct);
+					snprintf(cs, sizeof(cs), "%d", cnt);
+					ct = (TTF_RenderUTF8_Blended)(font.small, cs, tc);
+					if (ct) {
+						SDL_BlitSurface(ct, NULL, screen, &(SDL_Rect){x+w-9*s-ct->w, y+h-ct->h-9*s});
+						reserve = ct->w + 6*s;
+					}
+				}
+				if (ct) SDL_FreeSurface(ct);
+			}
+		}
+		GFX_truncateText(font.medium, name, shown, w-14*s-reserve, 0);
+		SDL_Surface* nm = TTF_RenderUTF8_Blended(font.medium, shown, tc);
+		if (nm) { SDL_BlitSurface(nm, NULL, screen, &(SDL_Rect){x+9*s, y+h-nm->h-8*s}); SDL_FreeSurface(nm); }
+	}
+
+	if (tile_toast_until) {
+		char tb[96];
+		snprintf(tb, sizeof(tb), "Тема: %s", GFX_themeName());
+		SDL_Surface* tt = (TTF_RenderUTF8_Blended)(font.small, tb, (SDL_Color){255,255,255});
+		if (tt) {
+			int pw = tt->w + 14*s, ph = tt->h + 6*s;
+			int px = (W - pw)/2, py = (H - ph)/2;
+			Tile_fillRound(screen, px, py, pw, ph, ph/2, Tile_pack(screen, 0, 0, 0));
+			SDL_BlitSurface(tt, NULL, screen, &(SDL_Rect){px+7*s, py+3*s});
+			SDL_FreeSurface(tt);
+		}
+	}
+
+	// page dots
+	if (pages>1) {
+		int dw = 8*s, dh = 4*s, dg = 5*s;
+		int active_w = 14*s;
+		int total_w = (pages-1)*(dw+dg) + active_w;
+		int dx = W/2 - total_w/2;
+		int dy = top_y + cell_h*TILE_ROWS + gap*(TILE_ROWS-1) + 10*s;
+		for (int p=0; p<pages; p++) {
+			int ww = (p==page) ? active_w : dw;
+			Tile_fillRound(screen, dx, dy, ww, dh, dh/2, (p==page) ? Tile_pack(screen,255,255,255) : Tile_pack(screen,dr,dg,db));
+			dx += ww + dg;
+		}
+	}
+}
