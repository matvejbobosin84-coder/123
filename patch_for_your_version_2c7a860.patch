diff --git a/workspace/all/common/i18n.h b/workspace/all/common/i18n.h
new file mode 100644
index 0000000..a22ad38
--- /dev/null
+++ b/workspace/all/common/i18n.h
@@ -0,0 +1,24 @@
+#ifndef I18N_H
+#define I18N_H
+
+// Runtime translation. Dictionary file: <sdcard>/.system/res/lang.txt
+// Format, one entry per line:   English text => Русский текст
+// Lines starting with # are comments. Missing file or missing entry = original text.
+// If the dictionary contains the line   #log   every text that has no translation is
+// appended to <sdcard>/.userdata/shared/untranslated.txt (one per line, no duplicates).
+
+const char* I18N_T(const char* text);
+
+// Every text measured or drawn through SDL_ttf passes through the dictionary.
+// A function-like macro is not re-expanded inside its own expansion, so the
+// inner name below is the real SDL_ttf function.
+#ifdef TTF_RenderUTF8_Blended
+#undef TTF_RenderUTF8_Blended
+#endif
+#ifdef TTF_SizeUTF8
+#undef TTF_SizeUTF8
+#endif
+#define TTF_RenderUTF8_Blended(font, text, color) TTF_RenderUTF8_Blended((font), I18N_T(text), (color))
+#define TTF_SizeUTF8(font, text, w, h) TTF_SizeUTF8((font), I18N_T(text), (w), (h))
+
+#endif
diff --git a/workspace/all/common/i18n_impl.h b/workspace/all/common/i18n_impl.h
new file mode 100644
index 0000000..04b23d3
--- /dev/null
+++ b/workspace/all/common/i18n_impl.h
@@ -0,0 +1,154 @@
+// Implementation of the runtime dictionary (included once, from api.c).
+// Kept separate from api.c so it can be unit-tested on a PC.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef I18N_DICT_PATH
+#define I18N_DICT_PATH RES_PATH "/lang.txt"
+#endif
+#ifndef I18N_LOG_PATH
+#define I18N_LOG_PATH SHARED_USERDATA_PATH "/untranslated.txt"
+#endif
+
+typedef struct {
+	char* key;
+	char* val;
+} I18N_Entry;
+
+static struct {
+	int loaded;
+	int logging;
+	char* data;          // whole file, modified in place
+	I18N_Entry* table;   // open addressing, size is a power of two
+	unsigned size;
+	unsigned count;
+	// misses already logged this session (to avoid duplicates)
+	char** seen;
+	unsigned seen_count;
+	unsigned seen_cap;
+} i18n;
+
+static unsigned I18N_hash(const char* s) {
+	unsigned h = 2166136261u;
+	while (*s) {
+		h ^= (unsigned char)*s++;
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void I18N_insert(char* key, char* val) {
+	unsigned i = I18N_hash(key) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, key)) { // later entry wins
+			i18n.table[i].val = val;
+			return;
+		}
+		i = (i + 1) & (i18n.size - 1);
+	}
+	i18n.table[i].key = key;
+	i18n.table[i].val = val;
+	i18n.count++;
+}
+
+static char* I18N_trim(char* s) {
+	while (*s==' ' || *s=='\t') s++;
+	char* e = s + strlen(s);
+	while (e>s && (e[-1]==' ' || e[-1]=='\t')) *--e = '\0';
+	return s;
+}
+
+static void I18N_load(void) {
+	i18n.loaded = 1;
+	FILE* f = fopen(I18N_DICT_PATH, "rb");
+	if (!f) return;
+	fseek(f, 0, SEEK_END);
+	long len = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	if (len<=0 || len>(4L*1024*1024)) { fclose(f); return; }
+	i18n.data = malloc(len + 1);
+	if (!i18n.data) { fclose(f); return; }
+	size_t got = fread(i18n.data, 1, len, f);
+	fclose(f);
+	i18n.data[got] = '\0';
+
+	char* p = i18n.data;
+	if ((unsigned char)p[0]==0xEF && (unsigned char)p[1]==0xBB && (unsigned char)p[2]==0xBF) p += 3; // BOM
+
+	// count lines to size the table
+	unsigned lines = 1;
+	for (char* c = p; *c; c++) if (*c=='\n') lines++;
+	unsigned size = 64;
+	while (size < lines * 2) size <<= 1;
+	i18n.table = calloc(size, sizeof(I18N_Entry));
+	if (!i18n.table) { free(i18n.data); i18n.data = NULL; return; }
+	i18n.size = size;
+
+	while (*p) {
+		char* eol = strchr(p, '\n');
+		if (eol) *eol = '\0';
+		char* next = eol ? eol + 1 : p + strlen(p);
+
+		size_t l = strlen(p);
+		if (l && p[l-1]=='\r') p[l-1] = '\0';
+
+		if (p[0]=='#') {
+			if (!strcmp(I18N_trim(p), "#log")) i18n.logging = 1;
+		}
+		else if (p[0]) {
+			char* sep = strstr(p, " => ");
+			if (sep) {
+				*sep = '\0';
+				char* key = I18N_trim(p);
+				char* val = I18N_trim(sep + 4);
+				if (key[0] && val[0]) I18N_insert(key, val);
+			}
+		}
+		p = next;
+	}
+}
+
+static void I18N_logMiss(const char* text) {
+	for (unsigned i=0; i<i18n.seen_count; i++) {
+		if (!strcmp(i18n.seen[i], text)) return;
+	}
+	if (i18n.seen_count==i18n.seen_cap) {
+		unsigned cap = i18n.seen_cap ? i18n.seen_cap * 2 : 128;
+		char** grown = realloc(i18n.seen, cap * sizeof(char*));
+		if (!grown) return;
+		i18n.seen = grown;
+		i18n.seen_cap = cap;
+	}
+	char* copy = strdup(text);
+	if (!copy) return;
+	i18n.seen[i18n.seen_count++] = copy;
+
+	FILE* f = fopen(I18N_LOG_PATH, "ab");
+	if (!f) return;
+	fprintf(f, "%s\n", text);
+	fclose(f);
+}
+
+static int I18N_hasLetters(const char* s) {
+	for (; *s; s++) {
+		unsigned char c = (unsigned char)*s;
+		if ((c>='A' && c<='Z') || (c>='a' && c<='z')) return 1;
+	}
+	return 0;
+}
+
+const char* I18N_T(const char* text) {
+	if (!text || !text[0]) return text;
+	if (!i18n.loaded) I18N_load();
+	if (!i18n.table) return text;
+
+	unsigned i = I18N_hash(text) & (i18n.size - 1);
+	while (i18n.table[i].key) {
+		if (!strcmp(i18n.table[i].key, text)) return i18n.table[i].val;
+		i = (i + 1) & (i18n.size - 1);
+	}
+	if (i18n.logging && I18N_hasLetters(text)) I18N_logMiss(text);
+	return text;
+}
diff --git a/workspace/all/common/playtime_impl.h b/workspace/all/common/playtime_impl.h
new file mode 100644
index 0000000..dea1499
--- /dev/null
+++ b/workspace/all/common/playtime_impl.h
@@ -0,0 +1,75 @@
+// Play time per game. File .userdata/shared/playtime.txt, lines:  seconds<TAB>full path
+// Included from api.c. Written by minarch, read by minui.
+#define PT_PATH SHARED_USERDATA_PATH "/playtime.txt"
+#define PT_MAX 4096
+
+int PT_get(const char* path) {
+	FILE* f = fopen(PT_PATH, "r");
+	if (!f) return 0;
+	char line[600];
+	int found = 0;
+	size_t pl = strlen(path);
+	while (fgets(line, sizeof(line), f)) {
+		char* tab = strchr(line, '\t');
+		if (!tab) continue;
+		char* p = tab+1;
+		size_t l = strlen(p);
+		while (l>0 && (p[l-1]=='\n' || p[l-1]=='\r')) p[--l] = '\0';
+		if (l==pl && strcmp(p, path)==0) { found = atoi(line); break; }
+	}
+	fclose(f);
+	return found;
+}
+
+void PT_add(const char* path, int secs) {
+	if (secs<=0 || !path || !path[0]) return;
+	static char (*paths)[512] = NULL;
+	static int* vals = NULL;
+	if (!paths) { paths = malloc(PT_MAX*512); vals = malloc(PT_MAX*sizeof(int)); }
+	if (!paths || !vals) return;
+	int n = 0, hit = -1;
+	FILE* f = fopen(PT_PATH, "r");
+	if (f) {
+		char line[600];
+		while (n<PT_MAX && fgets(line, sizeof(line), f)) {
+			char* tab = strchr(line, '\t');
+			if (!tab) continue;
+			char* p = tab+1;
+			size_t l = strlen(p);
+			while (l>0 && (p[l-1]=='\n' || p[l-1]=='\r')) p[--l] = '\0';
+			if (l==0 || l>=512) continue;
+			vals[n] = atoi(line);
+			strcpy(paths[n], p);
+			if (strcmp(p, path)==0) hit = n;
+			n++;
+		}
+		fclose(f);
+	}
+	if (hit>=0) vals[hit] += secs;
+	else if (n<PT_MAX && strlen(path)<512) { vals[n] = secs; strcpy(paths[n], path); n++; }
+	char tmp[256];
+	snprintf(tmp, sizeof(tmp), "%s.tmp", PT_PATH);
+	f = fopen(tmp, "w");
+	if (!f) return;
+	for (int i=0; i<n; i++) fprintf(f, "%d\t%s\n", vals[i], paths[i]);
+	fclose(f);
+	rename(tmp, PT_PATH);
+}
+
+void PT_format(int secs, char* out, int n) {
+	int m = secs/60;
+	if (m<1) snprintf(out, n, "< 1 мин");
+	else if (m<60) snprintf(out, n, "%d мин", m);
+	else if (m%60==0) snprintf(out, n, "%d ч", m/60);
+	else snprintf(out, n, "%d ч %d мин", m/60, m%60);
+}
+
+int PT_total(void) {
+	FILE* f = fopen(PT_PATH, "r");
+	if (!f) return 0;
+	char line[600];
+	long sum = 0;
+	while (fgets(line, sizeof(line), f)) sum += atoi(line);
+	fclose(f);
+	return (int)sum;
+}
diff --git a/workspace/all/common/standby_impl.h b/workspace/all/common/standby_impl.h
new file mode 100644
index 0000000..dd0254e
--- /dev/null
+++ b/workspace/all/common/standby_impl.h
@@ -0,0 +1,351 @@
+// Standby screen (clock + animation) shown before the real sleep.
+// Included from api.c.
+//  - Disable:  create empty file  .userdata/shared/disable-standby
+//  - Own animation: PNG frames  .system/res/standby/0.png, 1.png, 2.png ...  (up to 150)
+//    optional  .system/res/standby/delay.txt  with delay between frames in ms (default 100)
+//  - Time on screen (not charging): file .userdata/shared/standby-seconds with a number of seconds (default 300)
+#include <time.h>
+
+#define STANDBY_DISABLE_PATH SHARED_USERDATA_PATH "/disable-standby"
+#define STANDBY_DIR RES_PATH "/standby"
+#define STANDBY_MAX_FRAMES 240
+#define STANDBY_SECONDS 300 // default when not charging; while charging it stays on
+#define STANDBY_SECONDS_PATH SHARED_USERDATA_PATH "/standby-seconds" // optional: file with a number
+#define STANDBY_SECONDS_PATH2 SHARED_USERDATA_PATH "/standby-seconds.txt" // Windows often hides the .txt
+
+static void SB_circle(SDL_Surface* d, int cx, int cy, int r, Uint32 c) {
+	for (int dy=-r; dy<=r; dy++) {
+		int w = (int)sqrtf((float)(r*r - dy*dy));
+		SDL_FillRect(d, &(SDL_Rect){cx-w, cy+dy, w*2+1, 1}, c);
+	}
+}
+
+// ---- colour themes: file .userdata/shared/theme holds the number (changed with L1/R1 on the main screen) ----
+#define THEME_PATH SHARED_USERDATA_PATH "/theme"
+#define THEME_COUNT 5
+static const struct { const char* name; unsigned char top[3]; unsigned char bot[3]; unsigned char acc[3]; unsigned char mut[3]; unsigned char dot[3]; unsigned char panel[3]; } sb_themes[THEME_COUNT] = {
+	{"Синяя",      {11,16,40},  {22,28,70},  {0x7A,0x9B,0xFF}, {0xB8,0xBC,0xE0}, {0x5B,0x60,0x94}, {0x0B,0x10,0x20}},
+	{"Графит",     {14,14,17},  {38,39,46},  {0xD0,0xD3,0xDA}, {0xB4,0xB7,0xBE}, {0x5A,0x5C,0x64}, {0x0C,0x0C,0x0E}},
+	{"Фиолетовая", {26,12,44},  {58,26,86},  {0xB8,0x8C,0xFF}, {0xD2,0xC0,0xF0}, {0x7A,0x5F,0xA8}, {0x14,0x08,0x24}},
+	{"Лесная",     {8,28,22},   {16,60,42},  {0x5F,0xD6,0x9A}, {0xB4,0xE0,0xC8}, {0x4A,0x86,0x6C}, {0x05,0x16,0x10}},
+	{"Бордовая",   {38,10,18},  {74,22,34},  {0xFF,0x8A,0x9E}, {0xF0,0xC0,0xC8}, {0x9A,0x56,0x64}, {0x1E,0x06,0x0C}},
+};
+static int sb_theme = -1;
+int GFX_getTheme(void) {
+	if (sb_theme<0) {
+		sb_theme = 0;
+		FILE* f = fopen(THEME_PATH, "r");
+		if (!f) f = fopen(THEME_PATH ".txt", "r");
+		if (f) { int v = 0; if (fscanf(f, "%d", &v)==1 && v>=0 && v<THEME_COUNT) sb_theme = v; fclose(f); }
+	}
+	return sb_theme;
+}
+void GFX_setTheme(int t) {
+	sb_theme = ((t%THEME_COUNT)+THEME_COUNT)%THEME_COUNT;
+	FILE* f = fopen(THEME_PATH, "w");
+	if (f) { fprintf(f, "%d\n", sb_theme); fclose(f); sync(); }
+}
+// kind: 0 accent (rows, frames), 1 muted text, 2 inactive dots, 3 dark panel
+void GFX_themeColor(int kind, int* r, int* g, int* b) {
+	const unsigned char* c = kind==0 ? sb_themes[GFX_getTheme()].acc : kind==1 ? sb_themes[GFX_getTheme()].mut :
+	                         kind==2 ? sb_themes[GFX_getTheme()].dot : sb_themes[GFX_getTheme()].panel;
+	*r = c[0]; *g = c[1]; *b = c[2];
+}
+const char* GFX_themeName(void) { return sb_themes[GFX_getTheme()].name; }
+
+// gradient background with slowly drifting coloured blobs (no files needed)
+static void SB_gradient(SDL_Surface* d) {
+	int W = d->w, H = d->h;
+	int t = GFX_getTheme();
+	for (int y=0; y<H; y++) {
+		int r = sb_themes[t].top[0] + (sb_themes[t].bot[0]-sb_themes[t].top[0])*y/H;
+		int g = sb_themes[t].top[1] + (sb_themes[t].bot[1]-sb_themes[t].top[1])*y/H;
+		int b = sb_themes[t].top[2] + (sb_themes[t].bot[2]-sb_themes[t].top[2])*y/H;
+		SDL_FillRect(d, &(SDL_Rect){0,y,W,1}, SDL_MapRGB(d->format, r, g, b));
+	}
+}
+static void SB_drawBackground(SDL_Surface* d, unsigned ms) {
+	int W = d->w, H = d->h;
+	SB_gradient(d);
+	static const unsigned char col[5][3] = {
+		{0x4B,0x6E,0x16}, {0x45,0x28,0x84}, {0x7A,0x2A,0x52}, {0x0B,0x6B,0x7A}, {0x8A,0x4A,0x12}
+	};
+	float t = ms / 1000.0f;
+	for (int i=0; i<5; i++) {
+		float fx = 0.23f + 0.07f*i, fy = 0.19f + 0.05f*i;
+		int cx = W/2 + (int)(W*0.38f*sinf(t*fx + i*1.7f));
+		int cy = H/2 + (int)(H*0.34f*cosf(t*fy + i*2.3f));
+		int r = H/6 + (int)(H/30*sinf(t*0.9f + i));
+		SB_circle(d, cx, cy, r, SDL_MapRGB(d->format, col[i][0], col[i][1], col[i][2]));
+	}
+}
+
+static SDL_Surface* SB_text(TTF_Font* f, const char* s, SDL_Color c) {
+	return (TTF_RenderUTF8_Blended)(f, s, c); // parentheses: skip the translation macro
+}
+
+// text with a shadow is rendered once and cached (rendering TTF text every frame is slow on this CPU)
+typedef struct { TTF_Font* f; char s[64]; Uint32 col; SDL_Surface* sh; SDL_Surface* fg; } SB_TextCache;
+static SB_TextCache sb_tc[4];
+static int sb_tc_next = 0;
+static void SB_cacheFlush(void) {
+	for (int i=0; i<4; i++) {
+		if (sb_tc[i].sh) SDL_FreeSurface(sb_tc[i].sh);
+		if (sb_tc[i].fg) SDL_FreeSurface(sb_tc[i].fg);
+		sb_tc[i].sh = sb_tc[i].fg = NULL; sb_tc[i].f = NULL; sb_tc[i].s[0] = '\0';
+	}
+	sb_tc_next = 0;
+}
+static void SB_blitCentered(SDL_Surface* d, TTF_Font* f, const char* s, int y, SDL_Color c) {
+	int sh = FIXED_SCALE;
+	Uint32 col = ((Uint32)c.r<<16) | ((Uint32)c.g<<8) | c.b;
+	SB_TextCache* e = NULL;
+	for (int i=0; i<4; i++) if (sb_tc[i].fg && sb_tc[i].f==f && sb_tc[i].col==col && strcmp(sb_tc[i].s, s)==0) { e = &sb_tc[i]; break; }
+	if (!e) {
+		e = &sb_tc[sb_tc_next];
+		sb_tc_next = (sb_tc_next+1)%4;
+		if (e->sh) SDL_FreeSurface(e->sh);
+		if (e->fg) SDL_FreeSurface(e->fg);
+		e->f = f; e->col = col;
+		snprintf(e->s, sizeof(e->s), "%s", s);
+		e->sh = SB_text(f, s, (SDL_Color){0,0,0});
+		e->fg = SB_text(f, s, c);
+	}
+	if (e->sh) SDL_BlitSurface(e->sh, NULL, d, &(SDL_Rect){(d->w-e->sh->w)/2+sh+1, y+sh+1});
+	if (e->fg) SDL_BlitSurface(e->fg, NULL, d, &(SDL_Rect){(d->w-e->fg->w)/2, y});
+}
+
+static int SB_loadFrames(SDL_Surface** frames) {
+	int n = 0;
+	char path[256];
+	while (n<STANDBY_MAX_FRAMES) {
+		snprintf(path, sizeof(path), STANDBY_DIR "/%d.png", n);
+		if (access(path, F_OK)!=0) break;
+		SDL_Surface* s = IMG_Load(path);
+		if (!s) break;
+		SDL_Surface* c = SDL_ConvertSurface(s, gfx.screen->format, 0);
+		SDL_FreeSurface(s);
+		if (!c) break;
+		frames[n++] = c;
+	}
+	return n;
+}
+
+static void SB_blitFrame(SDL_Surface* d, SDL_Surface* f) {
+	// fast path: exact 2x pixel doubling (SDL_BlitScaled is too slow here and limits the frame rate)
+	int bpp = d->format->BytesPerPixel;
+	if (d->w==f->w*2 && d->h==f->h*2 && f->format->BytesPerPixel==bpp && (bpp==2 || bpp==4)) {
+		for (int y=0; y<f->h; y++) {
+			Uint8* sp = (Uint8*)f->pixels + (size_t)y*f->pitch;
+			Uint8* r0 = (Uint8*)d->pixels + (size_t)(2*y)*d->pitch;
+			if (bpp==2) {
+				const Uint16* s16 = (const Uint16*)sp;
+				Uint32* d32 = (Uint32*)r0;
+				for (int x=0; x<f->w; x++) { Uint32 p = s16[x]; d32[x] = p | (p<<16); }
+			}
+			else {
+				const Uint32* s32 = (const Uint32*)sp;
+				Uint32* d32 = (Uint32*)r0;
+				for (int x=0; x<f->w; x++) { d32[2*x] = s32[x]; d32[2*x+1] = s32[x]; }
+			}
+			memcpy(r0 + d->pitch, r0, (size_t)d->w*bpp);
+		}
+		return;
+	}
+	// "cover": fill the screen keeping the aspect ratio, crop the rest
+	SDL_Rect src = {0,0,f->w,f->h};
+	if ((long)f->w*d->h > (long)f->h*d->w) { // frame is wider
+		src.w = (int)((long)f->h*d->w/d->h);
+		src.x = (f->w-src.w)/2;
+	} else {
+		src.h = (int)((long)f->w*d->h/d->w);
+		src.y = (f->h-src.h)/2;
+	}
+	SDL_BlitScaled(f, &src, d, &(SDL_Rect){0,0,d->w,d->h});
+}
+
+// returns 1 if the user woke the device while the clock was shown, 0 if time ran out
+static int Standby_show(void) {
+	if (GetHDMI() || exists(STANDBY_DISABLE_PATH)) return 0;
+
+	SDL_Surface* screen = gfx.screen;
+	SDL_PauseAudio(1);
+	SB_cacheFlush();
+
+	TTF_Font* big = TTF_OpenFont(FONT_PATH, SCALE1(44));
+	if (!big) big = font.large;
+
+	SDL_Surface* frames[STANDBY_MAX_FRAMES];
+	int nframes = SB_loadFrames(frames);
+	int delay = 100;
+	{
+		FILE* f = fopen(STANDBY_DIR "/delay.txt", "r");
+		if (f) { int v = 0; if (fscanf(f, "%d", &v)==1 && v>=20 && v<=2000) delay = v; fclose(f); }
+	}
+
+	static const char* wd[] = {"воскресенье","понедельник","вторник","среда","четверг","пятница","суббота"};
+	static const char* mo[] = {"января","февраля","марта","апреля","мая","июня","июля","августа","сентября","октября","ноября","декабря"};
+
+	int seconds = STANDBY_SECONDS;
+	{
+		const char* paths[2] = {STANDBY_SECONDS_PATH, STANDBY_SECONDS_PATH2};
+		for (int i=0; i<2; i++) {
+			FILE* f = fopen(paths[i], "r");
+			if (!f) continue;
+			char buf[64] = {0};
+			size_t n = fread(buf, 1, sizeof(buf)-1, f);
+			fclose(f);
+			buf[n] = '\0';
+			char* p = buf;
+			while (*p && (*p<'0' || *p>'9')) p++; // skip BOM / spaces
+			if (*p) {
+				int v = atoi(p);
+				if (v>=5 && v<=3600) { seconds = v; break; }
+			}
+		}
+	}
+	while (SDL_PollEvent(&(SDL_Event){0})) {} // drop old events
+	uint32_t start = SDL_GetTicks();
+	uint32_t checked = start;
+	int charging = pwr.is_charging;
+	int woke = 0;
+	int last_idx = -1;
+	int last_sec = -1;
+
+	while (1) {
+		uint32_t loop_t0 = SDL_GetTicks();
+		// buttons are read by the platform (evdev), not by SDL events
+		PAD_poll();
+		if (PAD_anyJustPressed()) woke = 1;
+		SDL_Event ev;
+		while (SDL_PollEvent(&ev)) {
+			if (ev.type==SDL_KEYDOWN || ev.type==SDL_JOYBUTTONDOWN) woke = 1;
+		}
+		if (woke) break;
+
+		uint32_t now = loop_t0;
+		if (now-checked>=2000) {
+			int ch = 0, lvl = 0;
+			PLAT_getBatteryStatus(&ch, &lvl);
+			charging = ch;
+			checked = now;
+		}
+		if (!charging && now-start>=(uint32_t)seconds*1000) break;
+
+		time_t tt = time(NULL);
+		struct tm* lt = localtime(&tt);
+		int idx = nframes>0 ? (int)(((now-start)/delay) % nframes) : (int)((now-start)/33);
+		int sec = lt ? lt->tm_min*60+lt->tm_sec : 0;
+		if (idx==last_idx && sec==last_sec) { SDL_Delay(3); continue; } // nothing new to draw
+		last_idx = idx; last_sec = sec;
+
+		if (nframes>0) SB_blitFrame(screen, frames[idx]);
+		else SB_drawBackground(screen, now-start);
+
+		char buf[64];
+		if (lt) {
+			snprintf(buf, sizeof(buf), "%02d:%02d", lt->tm_hour, lt->tm_min);
+			SB_blitCentered(screen, big, buf, screen->h*30/100, (SDL_Color){255,255,255});
+			snprintf(buf, sizeof(buf), "%s, %d %s", wd[lt->tm_wday%7], lt->tm_mday, mo[lt->tm_mon%12]);
+			SB_blitCentered(screen, font.large, buf, screen->h*30/100 + SCALE1(54), (SDL_Color){0xE5,0xE7,0xEB});
+		}
+		if (charging) SB_blitCentered(screen, font.small, "Заряжается", screen->h - SCALE1(34), (SDL_Color){0xA3,0xE6,0x35});
+
+		GFX_flip(screen);
+		GFX_pan();
+		// if flip did not wait for vsync, do not spin faster than ~60 fps
+		uint32_t took = SDL_GetTicks() - loop_t0;
+		if (took<8) SDL_Delay(8-took);
+	}
+
+	for (int i=0; i<nframes; i++) SDL_FreeSurface(frames[i]);
+	SB_cacheFlush();
+	if (big!=font.large) TTF_CloseFont(big);
+	if (woke) SDL_PauseAudio(0);
+	return woke;
+}
