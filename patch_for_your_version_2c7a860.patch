+static void Menu_drawPause(SDL_Surface* screen, SDL_Surface* backing, const char* rom_name, int selected, int show_setting, const char* disc_name) {
+	int s = MIN(screen->w/320, screen->h/240);
+	if (s<1) s = 1;
+	int W = screen->w, H = screen->h;
+	int M = SCALE1(PADDING);
+
+	GFX_clear(screen);
+	GFX_drawBackdrop(screen);
+
+	char cname[128];
+	Menu_consoleName(cname, sizeof(cname));
+	int cr, cg, cb, dark;
+	GFX_consoleColor(cname[0] ? cname : core.tag, &cr, &cg, &cb, &dark);
+	Uint32 badge_col = SDL_MapRGB(screen->format, cr, cg, cb);
+	SDL_Color on_badge = dark ? (SDL_Color){0x0B,0x10,0x20} : (SDL_Color){0xFF,0xFF,0xFF};
+	int tr, tg, tb, mr, mg, mb, dr, dg, db, pr_, pg_, pb_;
+	GFX_themeColor(0, &tr, &tg, &tb);
+	GFX_themeColor(1, &mr, &mg, &mb);
+	GFX_themeColor(2, &dr, &dg, &db);
+	GFX_themeColor(3, &pr_, &pg_, &pb_);
+	Uint32 accent = SDL_MapRGB(screen->format, tr, tg, tb);
+	SDL_Color on_accent = {pr_, pg_, pb_};
+	SDL_Color muted_col = {mr, mg, mb};
+
+	// ----- header: console badge + game title + clock/battery
+	int ow = GFX_blitHardwareGroup(screen, show_setting, 0);
+	int badge_h = SCALE1(PILL_SIZE) - SCALE1(4);
+	int hy = M + SCALE1(2);
+	int extras = GFX_drawStatusExtras(screen, W - M - ow - SCALE1(6), hy, badge_h, 1);
+	SDL_Surface* tag = (TTF_RenderUTF8_Blended)(font.medium, core.tag, on_badge);
+	int badge_w = tag ? tag->w + SCALE1(14) : SCALE1(30);
+	GFX_fillRound(screen, M, hy, badge_w, badge_h, SCALE1(7), badge_col);
+	if (tag) {
+		SDL_BlitSurface(tag, NULL, screen, &(SDL_Rect){M + (badge_w - tag->w)/2, hy + (badge_h - tag->h)/2});
+		SDL_FreeSurface(tag);
+	}
+	int title_x = M + badge_w + SCALE1(8);
+	int title_max = W - M - ow - extras - title_x - SCALE1(8);
+	char shown[256];
+	GFX_truncateText(font.large, rom_name, shown, title_max, 0);
+	SDL_Surface* title = (TTF_RenderUTF8_Blended)(font.large, shown, COLOR_WHITE);
+	if (title) {
+		SDL_BlitSurface(title, NULL, screen, &(SDL_Rect){title_x, hy + (badge_h - title->h)/2});
+		SDL_FreeSurface(title);
+	}
+
+	// ----- rows
+	int top = M + SCALE1(PILL_SIZE) + SCALE1(8);
+	int row_h = 26*s, row_gap = 3*s;
+	int col_w = 150*s;
+	for (int i=0; i<MENU_ITEM_COUNT; i++) {
+		int ry = top + i*(row_h+row_gap);
+		SDL_Color tc = COLOR_WHITE;
+		if (i==selected) {
+			Uint32 fill = accent;
+			tc = on_accent;
+			if (i==ITEM_QUIT) { fill = SDL_MapRGB(screen->format, 0xFF,0x8F,0xA3); tc = (SDL_Color){0x0B,0x10,0x20}; }
+			GFX_fillRound(screen, M, ry, col_w, row_h, 8*s, fill);
+		}
+		else if (i==ITEM_QUIT) tc = (SDL_Color){0xFF,0x8F,0xA3};
+		SDL_Surface* t = TTF_RenderUTF8_Blended(font.large, menu.items[i], tc);
+		if (t) {
+			SDL_BlitSurface(t, NULL, screen, &(SDL_Rect){M + 10*s, ry + (row_h - t->h)/2});
+			SDL_FreeSurface(t);
+		}
+		if (i==selected && i==ITEM_CONT && menu.total_discs>1) {
+			SDL_Surface* d = (TTF_RenderUTF8_Blended)(font.small, disc_name, tc);
+			if (d) {
+				SDL_BlitSurface(d, NULL, screen, &(SDL_Rect){M + col_w - 8*s - d->w, ry + (row_h - d->h)/2});
+				SDL_FreeSurface(d);
+			}
+		}
+	}
+
+	// ----- right side: slot preview (save/load) or the paused game
+	int px = M + col_w + 10*s;
+	int pw = W - M - px;
+	int label_h = 16*s;
+	int fy = top + label_h;
+	int is_slot0 = (selected==ITEM_SAVE || selected==ITEM_LOAD);
+	int bottom_limit = H - M - SCALE1(PILL_SIZE) - 6*s; // keep clear of the hint pills
+	int fh = pw * 3 / 4;
+	int room = bottom_limit - fy - (is_slot0 ? 14*s : 0);
+	if (fh>room) fh = room;
+	if (fh<40*s) fh = 40*s;
+	if (pw>fh*4/3) pw = fh*4/3; // keep 4:3
+	int bd = 3*s; // frame thickness
+	int is_slot = (selected==ITEM_SAVE || selected==ITEM_LOAD);
+
+	char label[64];
+	if (is_slot) {
+		if (menu.slot==0) snprintf(label, sizeof(label), "Автосохранение");
+		else snprintf(label, sizeof(label), "Слот %d", menu.slot);
+	}
+	else snprintf(label, sizeof(label), "Игра");
+	SDL_Surface* lt = (TTF_RenderUTF8_Blended)(font.large, label, COLOR_WHITE);
+	if (lt) { SDL_BlitSurface(lt, NULL, screen, &(SDL_Rect){px, top + (label_h - lt->h)/2}); SDL_FreeSurface(lt); }
+	{
+		// total play time of this game
+		int pt = PT_get(game.path);
+		char pf[48], pl[80];
+		PT_format(pt, pf, sizeof(pf));
+		snprintf(pl, sizeof(pl), "Всего: %s", pt>0 ? pf : "0 мин");
+		SDL_Surface* ps = (TTF_RenderUTF8_Blended)(font.small, pl, muted_col);
+		if (ps) { SDL_BlitSurface(ps, NULL, screen, &(SDL_Rect){px + pw - ps->w, top + (label_h - ps->h)/2}); SDL_FreeSurface(ps); }
+	}
+
+	// frame: soft shadow, white outer line, theme-coloured border, dark panel
+	GFX_fillRound(screen, px+2*s, fy+3*s, pw, fh, 9*s, SDL_MapRGB(screen->format, 0, 0, 0));
+	GFX_fillRound(screen, px-s, fy-s, pw+2*s, fh+2*s, 9*s, SDL_MapRGB(screen->format, 255, 255, 255));
+	GFX_fillRound(screen, px, fy, pw, fh, 8*s, accent);
+	int ix = px + bd, iy = fy + bd, iw = pw - bd*2, ih = fh - bd*2;
+	GFX_fillRound(screen, ix, iy, iw, ih, 5*s, SDL_MapRGB(screen->format, pr_, pg_, pb_));
+	ix += 2*s; iy += 2*s; iw -= 4*s; ih -= 4*s;
+
+	if (!is_slot) {
+		// fit the game picture inside the frame keeping its proportions
+		int gw = iw, gh = ih;
+		if ((long)backing->w * ih > (long)backing->h * iw) gh = (int)((long)backing->h * iw / backing->w);
+		else gw = (int)((long)backing->w * ih / backing->h);
+		SDL_BlitScaled(backing, NULL, screen, &(SDL_Rect){ix + (iw-gw)/2, iy + (ih-gh)/2, gw, gh});
+	}
+	else {
+		SDL_Rect pr = {ix, iy, iw, ih};
+		if (menu.preview_exists) {
+			SDL_Surface* bmp = IMG_Load(menu.bmp_path);
+			if (!bmp) {
+				GFX_blitMessage(font.large, "No Preview", screen, &pr);
+			} else {
+				SDL_Surface* pv = zoomSurface(bmp, (1.0 * iw / bmp->w), (1.0 * ih / bmp->h), 0);
+				if (pv) { SDL_BlitSurface(pv, NULL, screen, &(SDL_Rect){ix, iy}); SDL_FreeSurface(pv); }
+				SDL_FreeSurface(bmp);
+			}
+		}
+		else {
+			if (menu.save_exists) GFX_blitMessage(font.large, "No Preview", screen, &pr);
+			else GFX_blitMessage(font.large, "Empty Slot", screen, &pr);
+		}
+
+		// slot dots
+		int dot = 4*s, gap = 4*s, act_w = 12*s;
+		int total_w = (MENU_SLOT_COUNT-1)*(dot+gap) + act_w + (MENU_SLOT_COUNT>0 ? (dot+gap) : 0);
+		int dx = px + (pw - total_w)/2;
+		int dy = fy + fh + 6*s;
+		// dot 0 = auto slot (red), then 1..MENU_SLOT_COUNT
+		for (int k=0; k<=MENU_SLOT_COUNT; k++) {
+			int cur = (k==menu.slot);
+			int ww = cur ? act_w : dot;
+			Uint32 col = cur ? SDL_MapRGB(screen->format, 255,255,255)
+			                 : (k==0 ? SDL_MapRGB(screen->format, 0xF8,0x71,0x71) : SDL_MapRGB(screen->format, dr, dg, db));
+			GFX_fillRound(screen, dx, dy, ww, dot, dot/2, col);
+			dx += ww + gap;
+		}
+	}
+
+	// ----- hints
+	if (show_setting && !GetHDMI()) {
+		GFX_blitHardwareHints(screen, show_setting, 0);
+	} else {
+		GFX_blitButtonGroup((char*[]){ BTN_SLEEP==BTN_POWER?"PWR":"MENU",pwractionstr, "Y","BOXART", NULL }, 0, screen, 0, 0);
+	}
+	GFX_blitButtonGroup((char*[]){ "B","BACK", "A","OKAY", NULL }, 1, screen, 1, 0);
+}
